{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm verify)",
      "Bash(pnpm -r run typecheck)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pnpm --filter @longdo/api test)",
      "Bash(pnpm --filter @longdo/api run test)",
      "Bash(pnpm --filter @longdo/api run typecheck)",
      "Bash(pnpm --filter @longdo/web run typecheck)",
      "Bash(pnpm --filter @longdo/web run build)",
      "Bash(node .claude/hooks/test-hooks.mjs)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(pnpm seed)",
      "Bash(docker compose:*)",
      "Bash(pnpm add:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-actions.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-before-stop.mjs\"",
            "timeout": 200
          }
        ]
      }
    ]
  }
}
